PORT=8080
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/cleartify.db

# Required for beta invite/activation token hashing.
# Generate a long random secret; do not reuse the admin token.
APP_SECRET=replace-with-at-least-32-random-characters

# Required to call POST /api/admin/invites.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# disabled = beta delivery endpoints return unavailable
# debug    = local development only; prints invite links/codes to logs
NOTIFICATION_MODE=debug

# Optional in development. Set both in production to sync the local SQLite-compatible
# database to a Turso Cloud database.
# TURSO_REMOTE_URL=https://your-database.your-region.turso.io
# TURSO_AUTH_TOKEN=
